# Generate a key pair once with:  npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address embedded in every push (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com
# Where subscriptions are stored
DATA_FILE=./subscriptions.json
# Port to listen on
PORT=8787
# Comma-separated origins allowed to call this server, or * for any
ALLOWED_ORIGINS=*
